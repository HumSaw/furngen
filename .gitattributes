# Normalise line endings so MAXScript files behave the same on Windows,
# where most 3ds Max artists work, and on macOS/Linux CI runners.
* text=auto eol=lf

# Explicit classification keeps .ms sources from being mistaken for Lua.
# Line endings stay LF everywhere; 3ds Max reads them on every supported version.
*.ms linguist-language=MAXScript

# Generated artefacts should never appear in diffs or language stats.
dist/** linguist-generated=true
pnpm-lock.yaml linguist-generated=true merge=binary

# Binary assets
*.png binary
*.jpg binary
*.zip binary
*.max binary
