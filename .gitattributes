# Normalise line endings so MAXScript files behave the same on Windows,
# where most 3ds Max artists work, and on macOS/Linux CI runners.
* text=auto eol=lf

# MAXScript is not in GitHub's language database, so linguist would
# otherwise leave these files uncounted. Map them to a close relative so
# the repository language bar reflects reality.
# Line endings stay LF everywhere, matching .editorconfig; 3ds Max reads
# LF files without complaint on every supported version.
*.ms linguist-language=Lua

# Generated artefacts should never appear in diffs or language stats.
dist/** linguist-generated=true
pnpm-lock.yaml linguist-generated=true merge=binary

# Binary assets
*.png binary
*.jpg binary
*.zip binary
*.max binary
